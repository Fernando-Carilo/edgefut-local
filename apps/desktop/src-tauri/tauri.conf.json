{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdgeFut AI",
  "version": "0.1.0",
  "identifier": "br.com.edgefut.ai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EdgeFut AI",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#F3F4F6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 http://localhost:8765 ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/edgefut-engine"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "publisher": "EdgeFut",
    "shortDescription": "Análise quantitativa de futebol com referência às odds da Superbet",
    "longDescription": "Assistente local que coleta dados públicos, roda modelos estatísticos e explica probabilidades, odd justa, edge e confiança. Não realiza apostas."
  },
  "plugins": {}
}
